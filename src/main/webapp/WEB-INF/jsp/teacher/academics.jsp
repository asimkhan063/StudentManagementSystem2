<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Teaching Center</title><script src="https://cdn.tailwindcss.com"></script></head>
<body class="min-h-screen bg-slate-100 text-slate-800"><main class="mx-auto max-w-6xl space-y-6 p-5 md:p-10">
<header><a href="${pageContext.request.contextPath}/teachers/dashboard" class="text-teal-700">← Dashboard</a><h1 class="mt-3 text-3xl font-bold">Assignments, quizzes and reports</h1><p class="mt-1 text-slate-500">Create class work, review submissions and view score summaries.</p></header>
<section class="grid gap-6 lg:grid-cols-2">
<div class="rounded-xl bg-white p-6 shadow"><h2 class="mb-4 text-xl font-semibold">Create assignment</h2><form id="assignmentForm" class="space-y-3">
<input class="w-full rounded border p-2" name="title" placeholder="Assignment title" required maxlength="140"><textarea class="w-full rounded border p-2" name="description" placeholder="Instructions" required maxlength="4000"></textarea>
<div class="grid grid-cols-3 gap-2"><input class="rounded border p-2" name="grade" placeholder="Grade" required><input class="rounded border p-2" name="section" placeholder="Section" required><input class="rounded border p-2" name="maxScore" type="number" min="1" value="100" required></div>
<label class="block text-sm">Due date<input class="mt-1 w-full rounded border p-2" name="dueDate" type="date" required></label><button class="rounded bg-teal-700 px-4 py-2 text-white">Publish assignment</button></form></div>
<div class="rounded-xl bg-white p-6 shadow"><h2 class="mb-4 text-xl font-semibold">Create MCQ quiz</h2><form id="quizForm" class="space-y-3"><input class="w-full rounded border p-2" name="title" placeholder="Quiz title" required><div class="grid grid-cols-2 gap-2"><input class="rounded border p-2" name="grade" placeholder="Grade" required><input class="rounded border p-2" name="section" placeholder="Section" required></div><div id="questions" class="space-y-3"></div><button id="addQuestion" type="button" class="rounded border px-3 py-2">Add question</button><button class="ml-2 rounded bg-indigo-700 px-4 py-2 text-white">Publish quiz</button></form></div>
</section>
<section class="rounded-xl bg-white p-6 shadow"><h2 class="text-xl font-semibold">Assignment submissions</h2><div id="submissions" class="mt-4 overflow-x-auto"></div></section>
<section class="rounded-xl bg-white p-6 shadow"><h2 class="text-xl font-semibold">Class report cards</h2><form id="reportForm" class="mt-3 flex flex-wrap gap-2"><input class="rounded border p-2" name="grade" placeholder="Grade" required><input class="rounded border p-2" name="section" placeholder="Section" required><button class="rounded bg-slate-800 px-4 py-2 text-white">Load analytics</button></form><div id="reports" class="mt-4 overflow-x-auto"></div></section>
<p id="notice" class="text-sm" role="status"></p></main>
<script>
const base="${pageContext.request.contextPath}/api/teacher/academics";const notice=document.getElementById("notice");
async function api(url,options={}){const r=await fetch(url,{...options,headers:{"Content-Type":"application/json",...(options.headers||{})}});const body=await r.text();if(!r.ok)throw Error(body||`Request failed (${r.status})`);return body?JSON.parse(body):null}
function cell(text,tag="td"){const x=document.createElement(tag);x.textContent=text??"—";x.className="border-b p-2";return x}
function question(){const box=document.createElement("fieldset");box.className="grid grid-cols-2 gap-2 rounded border p-3";const prompt=document.createElement("input");prompt.placeholder="Question";prompt.required=true;prompt.className="col-span-2 rounded border p-2";box.appendChild(prompt);const opts=[];["A","B","C","D"].forEach(letter=>{const input=document.createElement("input");input.placeholder=`Option ${letter}`;input.required=true;input.className="rounded border p-2";box.appendChild(input);opts.push(input)});const select=document.createElement("select");select.className="rounded border p-2";["A","B","C","D"].forEach(a=>{const o=document.createElement("option");o.value=a;o.textContent=`Correct: ${a}`;select.appendChild(o)});box.appendChild(select);box.dataset.question="true";box._fields={prompt,opts,select};return box}
document.getElementById("questions").appendChild(question());document.getElementById("addQuestion").onclick=()=>document.getElementById("questions").appendChild(question());
document.getElementById("assignmentForm").onsubmit=async e=>{e.preventDefault();const f=new FormData(e.target);try{await api(base+"/assignments",{method:"POST",body:JSON.stringify(Object.fromEntries(f))});notice.textContent="Assignment published.";e.target.reset()}catch(x){notice.textContent=x.message}};
document.getElementById("quizForm").onsubmit=async e=>{e.preventDefault();const f=new FormData(e.target);const questions=[...document.querySelectorAll("[data-question]")].map(q=>({prompt:q._fields.prompt.value,optionA:q._fields.opts[0].value,optionB:q._fields.opts[1].value,optionC:q._fields.opts[2].value,optionD:q._fields.opts[3].value,correctOption:q._fields.select.value}));try{await api(base+"/quizzes",{method:"POST",body:JSON.stringify({title:f.get("title"),grade:f.get("grade"),section:f.get("section"),questions})});notice.textContent="Quiz published.";e.target.reset();document.getElementById("questions").replaceChildren(question())}catch(x){notice.textContent=x.message}};
async function loadSubmissions(){try{const rows=await api(base+"/submissions");const table=document.createElement("table");table.className="min-w-full text-sm";const h=document.createElement("tr");["Assignment","Student","Response","Score","Feedback","Action"].forEach(v=>h.appendChild(cell(v,"th")));table.appendChild(h);rows.forEach(s=>{const tr=document.createElement("tr");[s.assignmentTitle,`${s.studentName} (${s.grade}-${s.section})`,s.responseText,`${s.score??"—"}/${s.maxScore}`,s.feedback].forEach(v=>tr.appendChild(cell(v)));const td=cell("");const score=document.createElement("input");score.type="number";score.min=0;score.max=s.maxScore;score.placeholder="Score";score.className="w-20 rounded border p-1";const feedback=document.createElement("input");feedback.placeholder="Feedback";feedback.className="mx-1 rounded border p-1";const btn=document.createElement("button");btn.textContent="Save";btn.className="rounded bg-teal-700 px-2 py-1 text-white";btn.onclick=async()=>{try{await api(`${base}/submissions/${s.submissionId}/grade`,{method:"PUT",body:JSON.stringify({score:Number(score.value),feedback:feedback.value})});notice.textContent="Grade saved.";loadSubmissions()}catch(x){notice.textContent=x.message}};td.append(score,feedback,btn);tr.appendChild(td);table.appendChild(tr)});document.getElementById("submissions").replaceChildren(table)}catch(x){notice.textContent=x.message}}
loadSubmissions();
document.getElementById("reportForm").onsubmit=async e=>{e.preventDefault();const f=new FormData(e.target);try{const data=await api(`${base}/report-cards?grade=${encodeURIComponent(f.get("grade"))}&section=${encodeURIComponent(f.get("section"))}`);const table=document.createElement("table");table.className="min-w-full text-sm";const h=document.createElement("tr");["Student","Class","Quiz count","Quiz avg","Assignments submitted","Graded","Assignment avg"].forEach(v=>h.appendChild(cell(v,"th")));table.appendChild(h);data.forEach(r=>{const tr=document.createElement("tr");[r.studentName,`${r.grade}-${r.section}`,r.quizCount,`${r.averageQuizPercentage}%`,r.assignmentsSubmitted,r.assignmentsGraded,r.averageAssignmentScore==null?"—":`${r.averageAssignmentScore}%`].forEach(v=>tr.appendChild(cell(String(v))));table.appendChild(tr)});document.getElementById("reports").replaceChildren(table)}catch(x){notice.textContent=x.message}};
</script></body></html>
