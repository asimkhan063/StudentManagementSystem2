<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>My Learning</title><script src="https://cdn.tailwindcss.com"></script></head>
<body class="min-h-screen bg-slate-100 text-slate-800"><main class="mx-auto max-w-5xl space-y-5 p-5 md:p-10"><header><a href="${pageContext.request.contextPath}/student/dashboard" class="text-teal-700">← Dashboard</a><h1 class="mt-3 text-3xl font-bold">My learning</h1></header><p id="notice" role="status" class="text-sm"></p><section class="rounded-xl bg-white p-5 shadow"><h2 class="text-xl font-semibold">Assignments</h2><div id="assignments" class="mt-3 space-y-3"></div></section><section class="rounded-xl bg-white p-5 shadow"><h2 class="text-xl font-semibold">Quizzes</h2><div id="quizzes" class="mt-3 space-y-4"></div></section><section class="rounded-xl bg-white p-5 shadow"><h2 class="text-xl font-semibold">My report card</h2><div id="report" class="mt-3"></div></section></main>
<script>
const base="${pageContext.request.contextPath}/api/student/academics";const notice=document.getElementById("notice");
async function api(url,options={}){const r=await fetch(url,{...options,headers:{"Content-Type":"application/json",...(options.headers||{})}});const t=await r.text();if(!r.ok)throw Error(t||`Request failed (${r.status})`);return t?JSON.parse(t):null}
function node(tag,text,cls){const e=document.createElement(tag);if(text!=null)e.textContent=text;if(cls)e.className=cls;return e}
async function load(){try{const [assignments,quizzes,report]=await Promise.all([api(base+"/assignments"),api(base+"/quizzes"),api(base+"/report-card")]);renderAssignments(assignments);renderQuizzes(quizzes);renderReport(report)}catch(e){notice.textContent=e.message}}
function renderAssignments(items){const host=document.getElementById("assignments");host.replaceChildren();if(!items.length){host.appendChild(node("p","No assignments available."));return}items.forEach(a=>{const card=node("article",null,"rounded-lg border p-4");card.appendChild(node("h3",a.title,"font-semibold"));card.appendChild(node("p",a.description,"mt-1 text-sm text-slate-600"));card.appendChild(node("p",`Due ${a.dueDate} · Max score ${a.maxScore}`,"mt-1 text-sm"));if(a.submissionId){card.appendChild(node("p",`Submitted ${a.submittedAt}${a.score==null?" · Awaiting grade":` · Score ${a.score}/${a.maxScore}`}${a.feedback?" · "+a.feedback:""}`,"mt-2 text-teal-700"))}else{const text=document.createElement("textarea");text.maxLength=8000;text.required=true;text.placeholder="Write your assignment response";text.className="mt-3 w-full rounded border p-2";const btn=node("button","Submit response","mt-2 rounded bg-teal-700 px-3 py-2 text-white");btn.onclick=async()=>{try{await api(`${base}/assignments/${a.assignmentId}/submit`,{method:"POST",body:JSON.stringify({responseText:text.value})});notice.textContent="Assignment submitted.";load()}catch(e){notice.textContent=e.message}};card.append(text,btn)}host.appendChild(card)})}
function renderQuizzes(items){const host=document.getElementById("quizzes");host.replaceChildren();if(!items.length){host.appendChild(node("p","No quizzes available."));return}items.forEach(q=>{const card=node("article",null,"rounded-lg border p-4");card.appendChild(node("h3",q.title,"font-semibold"));if(q.submittedAt){card.appendChild(node("p",`Result: ${q.score}/${q.maxScore} (${Math.round(q.score*100/q.maxScore)}%)`,"mt-2 text-teal-700"))}else{const answers=[];q.questions.forEach(question=>{const field=node("fieldset",null,"mt-3 rounded border p-3");field.appendChild(node("legend",question.prompt,"font-medium"));const select=document.createElement("select");select.className="mt-2 w-full rounded border p-2";select.add(new Option("Choose answer", ""));[["A",question.optionA],["B",question.optionB],["C",question.optionC],["D",question.optionD]].forEach(([letter,label])=>select.add(new Option(`${letter}. ${label}`,letter)));answers.push({questionId:question.questionId,select});field.appendChild(select);card.appendChild(field)});const btn=node("button","Submit quiz","mt-3 rounded bg-indigo-700 px-3 py-2 text-white");btn.onclick=async()=>{try{if(answers.some(a=>!a.select.value))throw Error("Answer every question first.");const result=await api(`${base}/quizzes/${q.quizId}/attempt`,{method:"POST",body:JSON.stringify({answers:answers.map(a=>({questionId:a.questionId,selectedOption:a.select.value}))})});notice.textContent=`Quiz submitted: ${result.score}/${result.maxScore} (${result.percentage}%).`;load()}catch(e){notice.textContent=e.message}};card.appendChild(btn)}host.appendChild(card)})}
function renderReport(r){const host=document.getElementById("report");host.replaceChildren(node("p",`Quiz average ${r.averageQuizPercentage}% · ${r.quizCount} quiz attempts · ${r.assignmentsSubmitted} assignments submitted · ${r.assignmentsGraded} graded · Assignment average ${r.averageAssignmentScore==null?"not graded yet":r.averageAssignmentScore+"%"}`,"text-slate-700"))}
load();
</script></body></html>
